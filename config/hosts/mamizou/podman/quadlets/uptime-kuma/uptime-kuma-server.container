[Unit]
Description=uptime-kuma server container

[Container]
Image=docker.io/louislam/uptime-kuma:2.0.2-rootless
ContainerName=uptime-kuma-server
Mount=type=bind,src=/var/lib/containers/storage/volumes/uptime-kuma,dst=/data
Pod=uptime-kuma.pod
AddCapability=NET_BIND_SERVICE
User=1000
Group=1000
PublishPort=127.0.0.1:3001:3001

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target default.target