[Unit]
Description=Navidrome server container

[Container]
Image=docker.io/deluan/navidrome:0.63.2
ContainerName=navidrome-server
Mount=type=bind,src=/var/lib/containers/storage/volumes/navidrome,dst=/data
Mount=type=bind,src=/srv/zfs/Media/Music,dst=/music,ro
Pod=navidrome.pod
AddCapability=NET_BIND_SERVICE
User=1000
Group=1000
EnvironmentFile=/etc/containers/systemd/navidrome/navidrome.env
Secret=navidrome-db-password,type=env,target=ND_PASSWORDENCRYPTIONKEY

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target default.target